# =============================================================================
# platform.env — configuración ÚNICA de la plataforma
#
#   cp config/platform.env.example config/platform.env
#   # editar los valores marcados con [OBLIGATORIO]
#   make render        # genera helm/values.yaml y k8s/pod_templates/pod_template.yaml
#
# config/platform.env está en .gitignore: contiene la secret key y datos del host.
# Todos los scripts (scripts/*.sh) y el Makefile leen este archivo.
# =============================================================================

# --- Rutas del host (nodo de Kubernetes) ---------------------------------------
# Ruta ABSOLUTA donde está clonado este repositorio EN EL NODO. Los volúmenes
# hostPath de dags/, libs/, files/, logs/ y pod_templates/ cuelgan de aquí.
PROJECT_PATH="/opt/airflow-platform"                      # [OBLIGATORIO]

# Directorio del host que contiene los entornos Conda. Recomendado: usar la
# MISMA ruta que se ve dentro del pod (/opt/conda/envs) para evitar problemas
# de prefijos hardcodeados de Conda.
CONDA_ENVS_HOST_PATH="/opt/conda/envs"
# Instalación de Miniconda (solo la usa scripts/create_conda_env.sh)
CONDA_HOME="/opt/miniconda3"
# Nombre del entorno aislado para @task.external_python. Su definición (versión
# de Python y librerías, todo fijado) está en envs/<PYTHON_ENV_NAME>/environment.yml
PYTHON_ENV_NAME="p313"

# --- Usuarios y permisos -------------------------------------------------------
# Dueño del código (dags/, libs/) y grupo Unix de los desarrolladores.
PROJECT_OWNER="airflow-admin"
DEV_GROUP="developers"
# UID con el que corren los pods de Airflow (imagen oficial = 50000). No cambiar
# salvo que se use una imagen con otro usuario.
AIRFLOW_UID="50000"

# --- Kubernetes / Helm -----------------------------------------------------------
AIRFLOW_NAMESPACE="airflow"
HELM_RELEASE="airflow"
# Versión del chart oficial apache-airflow/airflow, FIJADA: 1.22.0 es la validada con
# esta plantilla (Airflow 3.2.1, MicroK8s 1.35). Vacío = la última publicada en cada
# deploy (puede cambiar el comportamiento sin aviso). Para subirla: ver docs/10 §6.
# Versiones disponibles: helm search repo apache-airflow/airflow -l
AIRFLOW_CHART_VERSION="1.22.0"
# Volumen de PostgreSQL (metadatos). SOLO se aplican al crearlo (primer deploy):
# cambiarlos en una instalación existente hace fallar `helm upgrade`.
# STORAGE_CLASS vacío = la StorageClass por defecto del clúster (microk8s-hostpath
# en MicroK8s). 8Gi = el tamaño que el chart ya usaba por defecto.
STORAGE_CLASS=""
POSTGRES_STORAGE_SIZE="8Gi"
# Prefijo de kubectl (MicroK8s). Si usas otro Kubernetes: KUBECTL="kubectl"
KUBECTL="microk8s kubectl"

# --- Imagen de Airflow -------------------------------------------------------------
AIRFLOW_VERSION="3.2.1"
AIRFLOW_PYTHON_VERSION="3.12"
AIRFLOW_IMAGE_REPO="airflow-k8s-base"
AIRFLOW_IMAGE_TAG="1.0.0"

# --- Acceso a la UI ----------------------------------------------------------------
# IP del nodo accesible desde el navegador. Vacío = autodetectar (hostname -I).
SERVER_IP=""
# Puerto NodePort fijo del api-server (rango 30000-32767).
NODE_PORT="31399"

# --- Secret key (CSRF / sesiones) --------------------------------------------------
# Vacío = `make render` la genera con `openssl rand -base64 32` y la guarda aquí.
# Cambiarla invalida todas las sesiones abiertas del navegador.
WEBSERVER_SECRET_KEY=""

# --- Concurrencia (requiere helm upgrade al cambiar) -------------------------------
PARALLELISM="5"
MAX_ACTIVE_TASKS_PER_DAG="2"
WORKER_PODS_CREATION_BATCH_SIZE="4"

# --- Recursos del pod de tarea (worker) — NO requiere helm, solo `make render` -----
WORKER_CPU_REQUEST="250m"
WORKER_MEMORY_REQUEST="512Mi"
WORKER_CPU_LIMIT="2"
WORKER_MEMORY_LIMIT="8Gi"
# Tiempo máximo de vida de un pod de tarea (segundos). Corta tareas colgadas.
WORKER_ACTIVE_DEADLINE_SECONDS="5400"

# --- Alertas -------------------------------------------------------------------------
# Zona horaria que se muestra en los correos de fallo (dataplatform.alerts).
ALERT_TIMEZONE="UTC"
